{% comment %}
  Crown Seating Quiz
  Markup shell only. Questions, product data and scoring live in assets/crown-quiz-engine.js;
  screens are rendered by assets/crown-seating-quiz.js; styles in assets/crown-seating-quiz.css.
{% endcomment %}

{{ 'crown-seating-quiz.css' | asset_url | stylesheet_tag }}

<section
  class="cq"
  id="section-{{ section.id }}"
  style="--cq-red: {{ section.settings.primary_color | default: '#a42325' }}; --cq-ink: {{ section.settings.accent_color | default: '#1a1a1a' }};"
  {{ section.shopify_attributes }}
>
  <div class="cq__wrap">
    <header class="cq__intro">
      <p class="cq__eyebrow">{{ section.settings.subheading | default: 'Find your stool' }}</p>
      <h1 class="cq__heading">{{ section.settings.heading | default: 'Find the right Crown stool' }}</h1>
      {% if section.settings.description != blank %}
        <p class="cq__lead">{{ section.settings.description }}</p>
      {% endif %}
      {% if section.settings.show_trust_indicators %}
        <ul class="cq__facts">
          <li>6 quick questions</li>
          <li>About a minute</li>
          <li>Matched to the current lineup</li>
        </ul>
      {% endif %}
    </header>

    <div id="crown-quiz" class="cq__app" aria-live="polite">
      <noscript>
        <p class="cq__noscript">The stool finder needs JavaScript. You can browse every model on our <a href="{{ routes.collections_url }}">collections page</a> or contact us and we will help you choose.</p>
      </noscript>
    </div>

    {%- comment -%} Marker read by assets/hubspot-integration.js to know whether results are showing. {%- endcomment -%}
    <div id="results" style="display: none;" aria-hidden="true"></div>
  </div>
</section>

<script src="{{ 'crown-quiz-engine.js' | asset_url }}" defer></script>
<script src="{{ 'quiz-analytics.js' | asset_url }}" defer></script>
<script src="{{ 'hubspot-integration.js' | asset_url }}" defer></script>
<script src="{{ 'crown-seating-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Crown Seating Quiz",
  "settings": [
    {
      "type": "header",
      "content": "Quiz Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Find the right Crown stool"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small heading above the title",
      "default": "Professional Seating Finder"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Answer six quick questions and we will match you with the Crown stool that fits your role, build and budget, and show you exactly why."
    },
    {
      "type": "checkbox",
      "id": "show_trust_indicators",
      "label": "Show quick facts under the description",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent color (buttons, selections)",
      "default": "#a42325"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Text and dark color",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "Crown Seating Quiz"
    }
  ]
}
{% endschema %}
