{% comment %}
  Crown Seating — 30-Day Demo CTA
  Standalone "try before you buy" panel for product pages.
  Adds the fixed-price 30-Day Demo Stool product ($300, black vinyl) via the same
  /cart/add.js pattern as the configurator, capturing the stool model as a clean
  line-item property. Does NOT touch crown-product-configurator.liquid.
  One demo product covers every model (model name comes from the page's product.title).
  Enforces a hard cap of N demo units in the cart (default 2).
  Spec: docs/DEMO-PROGRAM.md
{% endcomment %}

{% liquid
  comment
    `host` = the product whose PAGE this section sits on (e.g. Aspen C70DS).
    Prefer the global `product` (the page product); fall back to closest.product.
    Do NOT confuse with section.settings.demo_product (the 30-Day Demo Stool).
  endcomment
  assign host = product | default: closest.product
  assign demo_product = section.settings.demo_product
  assign demo_variant = demo_product.selected_or_first_available_variant
  assign max_units = section.settings.max_demo_units | default: 2
%}

<div
  class="crown-demo section color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="crown-demo__wrap page-width">
    {% if demo_variant == blank %}
      {% comment %} Setup guard — only the merchant sees this in the editor {% endcomment %}
      <div class="crown-demo__setup">
        <strong>Demo CTA not configured.</strong>
        Pick your “30-Day Stool Demo” product in this section’s settings.
      </div>
    {% else %}
      <div class="crown-demo__card">
        <div class="crown-demo__badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>30-Day Demo Program</span>
        </div>

        <h3 class="crown-demo__heading">Try the {{ host.title }} for 30 days</h3>
        <p class="crown-demo__subtext">
          Demo the <strong>{{ host.title }}</strong> in your own workspace for a full 30 days, shipped in black vinyl.
          {{ section.settings.note | default: 'Decide to keep it and your $100 demo is applied to your order — not the right fit? Just send it back within 30 days.' }}
          You can demo up to {{ max_units }} stools at a time; shipping is calculated at checkout.
        </p>

        <div class="crown-demo__price-row">
          <span class="crown-demo__price">{{ demo_variant.price | money }}</span>
          <span class="crown-demo__price-note">demo fee · + shipping</span>
        </div>

        <button
          type="button"
          class="crown-demo__btn"
          id="crown-demo-start-{{ section.id }}"
          data-variant="{{ demo_variant.id }}"
          data-model="{{ host.title | escape }}"
          data-handle="{{ host.handle }}"
          data-max="{{ max_units }}"
        >
          <span class="crown-demo__btn-text">Start a 30-Day Demo</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>

        <p class="crown-demo__msg" id="crown-demo-msg-{{ section.id }}" role="alert" hidden></p>

        <ul class="crown-demo__points">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            $100 demo fee applied to your order if you keep it
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Full 30 days to decide — return it if it's not the right fit
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Ships unassembled in black vinyl
          </li>
        </ul>

        {% if section.settings.terms_page != blank %}
          <a href="{{ section.settings.terms_page }}" class="crown-demo__terms-link">See full demo program terms</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var btn = document.getElementById('crown-demo-start-' + sectionId);
    if (!btn) return;
    var msgEl = document.getElementById('crown-demo-msg-' + sectionId);
    var demoVariantId = parseInt(btn.dataset.variant, 10);
    var maxUnits = parseInt(btn.dataset.max, 10) || 2;

    function showMsg(text) {
      if (!msgEl) return;
      msgEl.textContent = text;
      msgEl.hidden = false;
    }
    function clearMsg() {
      if (!msgEl) return;
      msgEl.hidden = true;
      msgEl.textContent = '';
    }

    // Count demo units already in the cart. A line counts as a demo if it's the demo
    // variant OR carries the _demo property (covers any model added from any page).
    function demoUnitsInCart(cart) {
      var count = 0;
      (cart.items || []).forEach(function (item) {
        var isDemo = item.variant_id === demoVariantId ||
          (item.properties && (item.properties._demo === 'true' || item.properties._demo === true));
        if (isDemo) count += item.quantity;
      });
      return count;
    }

    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      clearMsg();
      var origText = btn.querySelector('.crown-demo__btn-text');
      var origLabel = origText ? origText.textContent : '';
      btn.disabled = true;
      if (origText) origText.textContent = 'Checking…';

      fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          var existing = demoUnitsInCart(cart);
          if (existing + 1 > maxUnits) {
            showMsg('You can demo up to ' + maxUnits + ' stools at a time. Review your cart to continue.');
            btn.disabled = false;
            if (origText) origText.textContent = origLabel;
            return null;
          }
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              items: [{
                id: demoVariantId,
                quantity: 1,
                properties: {
                  'Model': btn.dataset.model,
                  'Upholstery': 'Black Vinyl',
                  'Trial': '30 days',
                  '_demo': 'true',
                  '_demo_model_handle': btn.dataset.handle
                }
              }]
            })
          }).then(function (res) {
            if (!res.ok) throw new Error('Cart error');
            return res.json();
          }).then(function () {
            if (origText) origText.textContent = 'Added!';
            setTimeout(function () { window.location.href = '/cart'; }, 500);
          });
        })
        .catch(function (err) {
          console.error('Demo add to cart failed:', err);
          showMsg('Something went wrong. Please try again.');
          btn.disabled = false;
          if (origText) origText.textContent = origLabel;
        });
    });
  })();
</script>

{% stylesheet %}
  .crown-demo {
    --cd-blue: #4A7BA7;
    --cd-blue-dark: #3A6B97;
    --cd-gold: #B8996F;
    --cd-cream: #F7F3EE;
    --cd-dark: #2C3E50;
    --cd-muted: #7F8C8D;
    --cd-border: #E0D8CF;
  }

  .crown-demo__wrap {
    padding: 1.5rem 0;
  }

  .crown-demo__card {
    border: 1px solid var(--cd-border);
    border-radius: 12px;
    background: var(--cd-cream);
    padding: 1.5rem 1.5rem 1.25rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .crown-demo__setup {
    border: 1px dashed var(--cd-border);
    border-radius: 8px;
    background: #fff8ea;
    color: var(--cd-dark);
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .crown-demo__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cd-blue);
    background: rgba(74, 123, 167, 0.1);
    padding: 0.3rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 0.75rem;
  }

  .crown-demo__heading {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--cd-dark);
    margin: 0 0 0.4rem;
    line-height: 1.25;
  }

  .crown-demo__subtext {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--cd-muted);
    margin: 0 0 1rem;
  }

  .crown-demo__model {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--cd-dark);
    background: rgba(74, 123, 167, 0.06);
    border: 1px solid var(--cd-border);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    margin: 0 0 1rem;
  }

  .crown-demo__model strong {
    color: var(--cd-blue-dark);
  }

  .crown-demo__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .crown-demo__price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cd-blue);
  }

  .crown-demo__price-note {
    font-size: 0.8rem;
    color: var(--cd-muted);
  }

  .crown-demo__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.9rem 1.5rem;
    background: var(--cd-blue);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .crown-demo__btn:hover:not(:disabled) {
    background: var(--cd-blue-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(74, 123, 167, 0.25);
  }

  .crown-demo__btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .crown-demo__msg {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.85rem;
    background: rgba(192, 57, 43, 0.08);
    border: 1px solid rgba(192, 57, 43, 0.25);
    border-radius: 8px;
    color: #a93226;
    font-size: 0.85rem;
  }

  .crown-demo__points {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .crown-demo__points li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: var(--cd-dark);
  }

  .crown-demo__points svg {
    color: #27ae60;
    flex-shrink: 0;
  }

  .crown-demo__terms-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cd-blue);
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crown Demo CTA",
  "tag": "section",
  "class": "crown-demo-cta",
  "settings": [
    {
      "type": "product",
      "id": "demo_product",
      "label": "Demo product",
      "info": "Select the 30-Day Stool Demo product ($100, black vinyl). Its price and variant are used automatically. Required."
    },
    {
      "type": "number",
      "id": "max_demo_units",
      "label": "Max demo units per cart",
      "default": 2
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Policy line",
      "info": "The middle sentence of the description. Edit this to match your exact demo terms (e.g. whether the $300 is applied to the order).",
      "default": "Decide to keep it and your $300 demo is applied to your order — not the right fit? Just send it back within 30 days."
    },
    {
      "type": "url",
      "id": "terms_page",
      "label": "Demo terms page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Crown Demo CTA",
      "category": "Products"
    }
  ]
}
{% endschema %}
